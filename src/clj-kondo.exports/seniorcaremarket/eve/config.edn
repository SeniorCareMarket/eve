;; Eve's clj-kondo export — the consumer half of Eve's kondo model.
;;
;; Eve defines its own type/protocol-defining macros, shaped after
;; clojure.core's. Without this config, a consumer's clj-kondo reads
;; every eve/deftype use as unresolved symbols and leaves the bodies
;; unanalyzed (Phase 1 narcis census: 49 unresolved-symbol + 23
;; invalid-arity from this one gap).
;;
;; This file sits on Eve's classpath (under src/, a root every
;; consumer already composes). Consumers import it once:
;;
;;   clj-kondo --lint "<classpath>" --copy-configs --dependencies
;;
;; which copies it to .clj-kondo/imports/seniorcaremarket/eve/, and
;; activate it in their .clj-kondo/config.edn:
;;
;;   {:config-paths ["imports/seniorcaremarket/eve"]}
;;
;; The :lint-as map is identical to the one in Eve's own
;; .clj-kondo/config.edn (the local half); keep them in sync.
;;
;; The deftype family also needs the analyze-call hook in
;; hooks/eve_deftype.clj next to this file (per-pass protocol
;; translation, options map, generated-var declares — see its
;; docstring), wired by the :hooks entry below, and the
;; :linters exclusion for the two deftype residence locals
;; (sio__/offset__ — bound by the macro in every method body;
;; see Eve's .clj-kondo/config.edn header for the full reason).
;; Both are identical to the local half; keep them in sync too.
{:lint-as {eve.alpha/deftype clojure.core/deftype
           eve.alpha/extend-type clojure.core/extend-type
           eve.deftype/deftype clojure.core/deftype
           eve.deftype/eve-extend-type clojure.core/extend-type
           eve.deftype-proto.macros/deftype clojure.core/deftype
           eve.deftype-proto.macros/host-deftype clojure.core/deftype
           eve.record/defrecord clojure.core/defrecord
           eve.protocol/defprotocol clojure.core/defprotocol
           eve.stm/sync clojure.core/dosync
           eve.thread/deftask clojure.core/defn}
 :hooks {:analyze-call {eve.alpha/deftype hooks.eve-deftype/deftype
                        eve.deftype/deftype hooks.eve-deftype/deftype
                        eve.deftype-proto.macros/deftype hooks.eve-deftype/deftype
                        eve.deftype-proto.macros/host-deftype hooks.eve-deftype/deftype
                        eve.alpha/api-defs hooks.eve-api-defs/alpha
                        eve.thread/api-defs hooks.eve-api-defs/thread}}
 :linters {:unresolved-symbol {:exclude [sio__ offset__]}}}

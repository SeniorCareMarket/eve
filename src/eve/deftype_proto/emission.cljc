(ns eve.deftype-proto.emission
  "The shared flat emission of Eve's one deftype tree (plan §4, slice
   M3): the expansion pieces BOTH type macros — the proto engine's
   eve.deftype-proto.macros/deftype and the public engine's
   eve.deftype/deftype — emit identically for every type they define:
   the sister field descriptors, the generated <TypeName>? predicate,
   the sister registration call, the IFreezeThaw method pairs, and the
   sister class generation call.

   These helpers live in the proto layer and are pure form-building.
   Each macro supplies the field list from ITS OWN registry's layout —
   the layout arithmetic stays each engine's (plan §3(a): proto's
   natural sizes, the public engine's padded slots) — and its own
   generator name for the predicate's docstring; everything downstream
   of those inputs is built here, once. Before M3 each macro carried
   its own copy of this code; the copies could drift without anything
   noticing. The slice's gate is that they provably did not: the
   descriptors and registrations of the existing types are
   byte-identical before and after the unification.

   The pattern is R0's (plan §8): eve.deftype-proto.type-io moved into
   the proto layer and is consumed by both macros the same way. This
   namespace requires nothing, so neither macro's load graph changes
   shape by consuming it.")

(defn sister-fields
  "A type's sister field descriptors: its written slab fields as data,
   in declaration order — {:name :keyword :type-class :type-hint
   :mutability :offset} per field, the shape eve.flat.sister/
   register-sister! registers (the fields that are not written are not
   among them — ^:host fields on the public side, ^:cached fields on
   the proto side; the caller filters its own layout's field list
   before calling, so which fields are written stays each engine's
   layout truth)."
  [fields]
  (mapv (fn [f] {:name (:name f)
                 :keyword (keyword (:name f))
                 :type-class (:type-class f)
                 :type-hint (some-> (:type-hint f) name)
                 :mutability (:mutability f)
                 :offset (:offset f)})
        fields))

(defn pred-form
  "The generated <TypeName>? predicate: both of a type's forms answer
   to its name, by the type key (eve.deftype-proto.data/type-key-of).
   generator names the emitting macro in the docstring — the one word
   in which the two engines' predicates have ever differed
   (\"eve-deftype\"; \"eve.deftype-proto.macros/deftype\"). Library
   authors wrap the generated predicate under their own name as they
   choose (eve.dataset/dataset? wraps Dataset?).

   classes: the host classes the type's forms are (the persistent kind,
   and its flat sister where the host realizes one), where the host's
   instance? reads a class — then each is one instance? test, ahead of
   the type key's compare: the dual-type check every type gets, one
   instanceof per form on the JVM (2026-11-20 ET). nil: the type key
   alone, as before."
  ([type-name type-key generator] (pred-form type-name type-key generator nil))
  ([type-name type-key generator classes]
   (list 'defn (symbol (str (name type-name) "?"))
         (str "True when x is a " (name type-name) " — its persistent form "
              "or its flat sister alike. Generated by " generator " from the "
              "type's key; library authors wrap it under their own predicate "
              "name as they choose.")
         ['x]
         (let [by-key (list '= type-key (list 'eve.deftype-proto.data/type-key-of 'x))]
           (if (seq classes)
             (concat ['or] (map (fn [c] (list 'instance? c 'x)) classes) [by-key])
             by-key)))))

(def ^:private lookup-protocols
  ;; a body that answers lookups itself: the type's own ILookup (either
  ;; engine's name) or the JVM's keyword-lookup interface. Spelled as a
  ;; constructor, not a quoted literal: a quoted set literal evaluates
  ;; to a PersistentList on let-go (measured on lg-eve, 2026-11-22),
  ;; and contains? over it throws there.
  (hash-set 'ILookup 'cljs.core/ILookup 'clojure.lang.ILookup 'IKeywordLookup 'clojure.lang.IKeywordLookup))

(defn default-lookup-forms
  "THE DUAL-TYPE FIELD LOOKUP every eve-deftype gets (2026-11-20 ET): an
   ILookup over the type's slab fields, (:field x) and (get x :field) —
   appended to the body as the type's author would write it, in
   ClojureScript's names, so every host's protocol translation realizes it
   and both of the type's forms carry it (the persistent kind reads its
   fields as its methods do; the flat sister from its source). A field
   read inside the body is the host's direct read on each form, where a
   reader outside it holding either form has no one class to hint: the
   lookup is the one fast door for both. nil when the body answers lookups
   itself (parsed-protos names ILookup), or the type has no slab field."
  [parsed-protos field-syms]
  (when (and (seq field-syms)
             (not-any? #(contains? lookup-protocols (:protocol %)) parsed-protos))
    (let [arms (mapcat (fn [s] [(keyword (name s)) s]) field-syms)]
      ['ILookup
       (list '-lookup '[this__lookup k__lookup]
             (concat ['clojure.core/case 'k__lookup] arms [nil]))
       (list '-lookup '[this__lookup k__lookup nf__lookup]
             (concat ['clojure.core/case 'k__lookup] arms ['nf__lookup]))])))

(defn register-sister-form
  "The eve.flat.sister/register-sister! call: the type key, the sister
   field descriptors, and the generated factory (a Type__sister
   symbol, or nil on a host that realizes no sister class — the
   layout-only posture, whose packed values read as generic records).

   The 4-arity carries the proto engine's options (plan §4, M2):
   :generated-by names the emitting macro and :cached-derivations
   records a proto type's ^:cached derivations. The public engine's
   call carries no options; register-sister! defaults its
   :generated-by to :eve-deftype.

   LOAD-ORDER CONTRACT: the call is a top-level form in the defining
   namespace's compiled output, so the defining namespace must
   require [eve.flat.sister] in its own ns form — a macro
   namespace's require cannot order a ClojureScript bundle (the
   macro ns is not a runtime graph node). eve.deftype-guard-test
   enforces the require on every registering namespace."
  ([type-key fields factory-name]
   (list 'eve.flat.sister/register-sister! type-key fields factory-name))
  ([type-key fields factory-name opts]
   (list 'eve.flat.sister/register-sister! type-key fields factory-name opts)))

(defn freeze-thaw-forms
  "The generated freeze/thaw method pairs (eve.flat.sister/
   IFreezeThaw), as a vector of extend-type forms: the pair on the
   persistent kind — total on it: -freeze freezes it, -thaw is its
   materialization — and, when flat-name (a sister class was
   realized), the pair on the flat kind, reversed: -thaw thaws it,
   -freeze freezes the flat value into a domain. The dispatcher never
   calls a method a kind does not have."
  ([type-name flat-name] (freeze-thaw-forms type-name flat-name nil))
  ([type-name flat-name env]
  ;; A ClojureScript compile (env carries :ns) names cljs.core's
  ;; extend-type: the expansion lands in the caller's namespace, where a
  ;; bare extend-type may be a referred eve.alpha/extend-type
  ;; (eve.deftype-test refers it), which re-expands the pair through
  ;; eve-extend-type and fails on the unregistered flat name. Other
  ;; hosts keep the bare symbol their core resolves.
  (let [xt (if (:ns env) 'cljs.core/extend-type 'extend-type)]
  (cond-> [(list xt type-name
                 'eve.flat.sister/IFreezeThaw
                 (list '-freeze ['x 'sio]
                       (list 'eve.flat.sister/freeze-instance 'sio 'x))
                 (list '-thaw ['x]
                       (list 'eve.flat.sister/thaw-instance 'x)))]
    flat-name
    (conj (list xt flat-name
                'eve.flat.sister/IFreezeThaw
                (list '-thaw ['x]
                      (list 'eve.flat.sister/thaw-instance 'x))
                (list '-freeze ['x 'sio]
                      (list 'eve.flat.sister/freeze-instance 'sio 'x))))))))

(defn flat-forms
  "The sister class generation, where the host realizes one: the
   shared eve.types/flat-type generator called with the macro's ctx
   (assembled from its own registry's layout — which fields are
   instance, live, and slab fields is each engine's). A host whose
   eve.types has no flat-type realizes no class and this answers nil:
   the type registers its layout alone. The proto macro additionally
   gates this call on its body's sister-eligibility (plan §4, M2) —
   that gate is the proto macro's, not the generator call's."
  [ctx]
  (when-let [st (resolve 'eve.types/flat-type)]
    (st ctx)))

(defn- plain-ir
  "A plain EDN value as the packer's IR, or nil when the value is
   outside the subset (bytes, uuid, inst, a typed/meta rep, a record)."
  [v]
  (cond
    (nil? v) #js {:t 0}
    (boolean? v) #js {:t 1 :v v}
    (keyword? v) #js {:t 2 :ns (namespace v) :n (name v) :s (str v)}
    (symbol? v) #js {:t 3 :ns (namespace v) :n (name v) :s (str v)}
    (string? v) #js {:t 4 :v v}
    (and (exists? js/BigInt) (instance? js/BigInt v)) #js {:t 5 :v v}
    (and (number? v) (== v (js/Math.floor v)) (js/isFinite v)) #js {:t 5 :v v}
    (number? v) #js {:t 6 :v v}
    (record? v) nil
    (map? v) (let [xs (into-array
                       (keep (fn [[k x]]
                               (let [ki (plain-ir k) xi (plain-ir x)]
                                 (when (and ki xi) #js [ki xi])))
                             v))]
               (when (== (alength xs) (count v))
                 #js {:t 7 :xs xs}))
    (set? v) (let [xs (into-array (keep plain-ir v))]
               (when (== (alength xs) (count v))
                 #js {:t 9 :xs xs}))
    (vector? v) (let [xs (into-array (keep plain-ir v))]
                  (when (== (alength xs) (count v))
                    #js {:t 8 :xs xs}))
    (sequential? v) (let [xs (into-array (keep plain-ir v))]
                      (when (== (alength xs) (count v))
                        #js {:t 10 :xs xs}))
    :else nil))

(defn pack-plain
  "rep packed as FORMAT-V1 bytes, or nil when the fast path does not
   apply. hq is the recipe hasheq (the value's host hasheq for a plain
   map, which matches node-hasheq*)."
  [rep hq]
  (when-let [ir (plain-ir rep)]
    (try
      (let [f (.-packPlain js/globalThis)]
        (when f (f ir hq)))
      (catch :default _ nil))))

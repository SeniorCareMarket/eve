(defprotocol P (m [x]) (m2 [x y]))
(deftype T [a ^:mutable b] P (m [_] [:T a]) (m2 [_ y] (+ a y)))
(println :deftype (m (->T 1 2)) (m2 (T. 3 4) 1) (satisfies? P (->T 1 2)) (instance? T (->T 1 2)) (type (->T 1 2)))
(defrecord R [a])
(println :record (:a (->R 5)) (satisfies? P (->R 5)))
(extend-type R P (m [r] [:R (:a r)]) (m2 [r y] y))
(println :extend (m (->R 6)))
(def rf (reify P (m [_] :reified) (m2 [_ y] y)))
(println :reify (m rf))
(extend-protocol P nil (m [_] :nil) (m2 [_ y] y))
(println :nil (m nil))
(deftype U [a] Object (toString [_] (str "U" a)))
(println :tostring (str (->U 1)))

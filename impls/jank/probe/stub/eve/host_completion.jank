(ns eve.host-completion)
;; J0 probe scratch: jank's core TODO stubs re-rooted (alter-var-root holds for namespaces compiled after: measured)
(defn- wrap [bits]
  (let [m (dec (bit-shift-left 1 bits)) half (bit-shift-left 1 (dec bits)) full (bit-shift-left 1 bits)]
    (fn [x] (let [u (bit-and (long x) m)] (if (>= u half) (- u full) u)))))
(def ^:private i8 (wrap 8))
(def ^:private i16 (wrap 16))
(def ^:private i32 (wrap 32))
(defn- re-root! [sym f] (alter-var-root (ns-resolve 'clojure.core sym) (fn [_] f)))
(re-root! 'unchecked-byte i8)
(re-root! 'unchecked-short i16)
(re-root! 'unchecked-int i32)
(re-root! 'unchecked-long (fn [x] (long x)))
(re-root! 'unchecked-add (fn [a b] (+ a b)))
(re-root! 'unchecked-subtract (fn [a b] (- a b)))
(re-root! 'unchecked-multiply (fn [a b] (* a b)))
(re-root! 'unchecked-inc (fn [a] (+ a 1)))
(re-root! 'unchecked-dec (fn [a] (- a 1)))
(re-root! 'unchecked-negate (fn [a] (- a)))
(re-root! 'unchecked-add-int (fn [a b] (i32 (+ a b))))
(re-root! 'unchecked-subtract-int (fn [a b] (i32 (- a b))))
(re-root! 'unchecked-multiply-int (fn [a b] (i32 (* (i32 a) (i32 b)))))
(re-root! 'unchecked-inc-int (fn [a] (i32 (+ a 1))))
(re-root! 'unchecked-dec-int (fn [a] (i32 (- a 1))))
(re-root! 'unchecked-negate-int (fn [a] (i32 (- a))))
(re-root! 'unchecked-divide-int (fn [a b] (i32 (quot a b))))
(re-root! 'unchecked-remainder-int (fn [a b] (i32 (rem a b))))
(re-root! 'byte i8)
(re-root! 'short i16)
(re-root! 'class (fn [x] (type x)))
(println :jank-scratch-completion-loaded)

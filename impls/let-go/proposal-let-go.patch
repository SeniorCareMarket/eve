+// IAtom is what swap!/swap-vals!/reset!/reset-vals!/compare-and-set! need
+// from a reference. *Atom satisfies it unchanged (atom.go Reset/Swap/
+// CompareAndSet/Deref). PROPOSAL (EVE port): lets a type defined
+// outside pkg/vm be an atom.
+type IAtom interface {
+	Value
+	Deref() Value
+	Swap(fn Fn, args []Value) (Value, error)
+	Reset(newVal Value) (Value, error)
+	CompareAndSet(oldVal, newVal Value) (bool, error)
+}
+
+// IDisj is what disj needs from a set type defined outside pkg/vm.
+// PROPOSAL (EVE port).
+type IDisj interface {
+	Value
+	Disj(Value) Value
+}
+
 type Receiver interface {
 	Value
 	InvokeMethod(Symbol, []Value) (Value, error)

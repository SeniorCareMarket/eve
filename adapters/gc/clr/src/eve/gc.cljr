(ns eve.gc
  "eve's GC hook (feature gc, adapters/README.md) on ClojureCLR: .NET weak references, polled by eve. token answers a
   fresh object; the read's cell holds it alone, and when the GC collects the cell the token's WeakReference reports
   it dead. sweep! scans the registered tokens and runs the releases of the dead ones — amortized: a scan runs once
   the registrations since the last one reach half the live count (at least 64), so a read's sweep is O(1) amortized.

   token's release must not reach the token's holder. Written 2026-11-20 without a .NET runtime to run it on.")

(def ^:private registry (atom []))
(def ^:private since (atom 0))

(defn available? [] true)

(defn- scan! []
  (let [dead (volatile! [])]
    (swap! registry
           (fn [rs]
             (vreset! dead [])
             (into [] (remove (fn [[^System.WeakReference w release]]
                                (when-not (.IsAlive w) (vswap! dead conj release) true)))
                   rs)))
    (reset! since 0)
    (doseq [release @dead] (release))))

(defn sweep!
  "Run the releases of the tokens collected since the last scan (when enough registrations have accumulated)."
  []
  (when (>= @since (max 64 (quot (count @registry) 2)))
    (scan!)))

(defn token
  "A fresh object whose collection runs (release) at a later sweep."
  [release]
  (sweep!)
  (let [t (Object.)]
    (swap! registry conj [(System.WeakReference. t) release])
    (swap! since inc)
    t))

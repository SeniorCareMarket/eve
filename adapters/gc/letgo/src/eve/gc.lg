(ns eve.gc
  "eve's GC hook (feature gc, adapters/README.md) on let-go (lg-eve): a Go finalizer. token answers a box
   (lg-eve's natives, impls/let-go/evenative/gc.go) that the cell holds; when the GC collects the cell the box goes with it, and
   its finalizer records the box's id. sweep! takes the ids and runs those releases on eve's own goroutine (a Go
   finalizer runs no let-go code). eve.view sweeps at every read.

   token's release must not reach the box's holder (a release that holds obj keeps it alive).")

(def ^:private counter (atom 0))
(def ^:private registry (atom {}))

(defn available? [] true)

(defn sweep!
  "Run the releases of the objects collected since the last sweep."
  []
  (doseq [id (eve.gc-native/take-collected)]
    (when-let [release (get @registry id)]
      (swap! registry dissoc id)
      (release))))

(defn token
  "A box whose collection runs (release): whatever holds it (eve.view's read cell) is collected with it."
  [release]
  (sweep!)
  (let [id (swap! counter inc)]
    (swap! registry assoc id release)
    (eve.gc-native/new-box id)))

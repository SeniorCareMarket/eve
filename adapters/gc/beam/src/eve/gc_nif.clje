(ns eve.gc-nif
  "clojerl's side of eve's GC NIF (native/eve_gc_nif.c): a resource term whose destructor records its id (eve.gc).
   clojerl compiles this namespace to the Erlang module 'eve.gc-nif'; new-box and take-collected are stubs that
   erlang:load_nif/2 replaces with the C functions. Built on first use, and again whenever its source is newer, into
   target/clje/eve_gc_nif.so in this adapter's root (gcc and the BEAM's erl_nif.h), as eve.clje-nif is.")

(defn- path [& parts] (erlang/binary_to_list (apply str parts)))

(defn- mtime [p]
  (let [t (filelib/last_modified (path p))]
    (if (= 0 t) 0 (calendar/datetime_to_gregorian_seconds t))))

(defn- adapter-root []
  (some (fn [d]
          (let [d (erlang/list_to_binary d)]
            (when (filelib/is_regular (path d "/eve/gc_nif.clje"))
              (erlang/list_to_binary (filename/dirname (path d))))))
        (code/get_path)))

(defn- build! [c so]
  (filelib/ensure_dir (path so))
  (let [tmp (str so "." (erlang/list_to_binary (os/getpid)))
        inc (str (erlang/list_to_binary (code/root_dir)) "/usr/include")
        link (if (= :darwin (erlang/element 2 (os/type))) " -undefined dynamic_lookup" "")]
    (os/cmd (path "gcc -O2 -fPIC -shared" link " -I'" inc "' -o '" tmp "' '" c "' 2>&1"))
    (when (filelib/is_regular (path tmp))
      (file/rename (path tmp) (path so)))))

(defn load!
  "Load the NIF (building it first when needed). :ok, or anything else when it could not be built or loaded."
  []
  (try
    (if-let [root (adapter-root)]
      (let [c (str root "/native/eve_gc_nif.c")
            so (str root "/target/clje/eve_gc_nif.so")]
        (when (< (mtime so) (mtime c)) (build! c so))
        (let [r (erlang/load_nif (path (subs so 0 (- (count so) 3))) 0)]
          (if (or (= r :ok)
                  (and (erlang/is_tuple r) (= :reload (erlang/element 1 (erlang/element 2 r)))))
            :ok
            r)))
      :no-root)
    (catch _ e e)))

(defn new-box [id] (erlang/nif_error :nif-not-loaded))
(defn take-collected [] (erlang/nif_error :nif-not-loaded))

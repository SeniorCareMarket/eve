(ns eve.gc
  "eve's GC hook (feature gc, adapters/README.md) on basilisp: Python's weakref.finalize, which runs a release when its
   object is collected (CPython: at once, by reference count; a cycle, at the cycle collector). Measured on a basilisp
   deftype instance, 2026-11-20.

   on-collect's release must not reach obj (the finalizer holds the release strongly)."
  (:import weakref))

(defn available? [] true)

(defn sweep!
  "Nothing to sweep: weakref.finalize runs its releases itself."
  []
  nil)

(defn on-collect
  "Run (release) once obj has been collected. Answers what obj must hold for that to happen (nil here)."
  [obj release]
  (weakref/finalize obj release)
  nil)

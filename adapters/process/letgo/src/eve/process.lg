(ns eve.process
  "eve's process primitives (HOST-CONTRACT §5) on let-go (lg-eve: eve/impls/let-go, its Go package linked into a
   custom lg): the clock, sleep, the operating system's entropy and standard input's lines are lg-eve's natives
   (eve.host-native, impls/let-go/evenative/host.go); a periodic timer runs on a let-go future (a goroutine); files'
   existence is let-go's os/stat; a file's exclusive creation and a domain directory's creation are lg-eve's
   natives too (eve.native, impls/let-go/evenative/region.go) — a disk domain's creation needs them, the network
   atom does not (eve/doc/network-atoms/ADAPTERS.md §2). What let-go still reaches no word for — a signalled
   exit's hooks, an object's address — throws or approximates, as below."
  (:refer-clojure :exclude [read-line file-exists?]))

(defn now-ms [] (eve.host-native/now-ms))

(defn thread-id
  "The identity a pinned epoch is kept under: let-go's current thread object, as text."
  []
  (str (Thread/currentThread)))

(defn sleep-ms!
  "Block this goroutine for about ms milliseconds."
  [ms]
  (eve.host-native/sleep-ms (long ms)))

(defn start-timer!
  "Call f every period-ms until stop-timer!: a future of its own. Returns the handle (a flag the future reads between
   periods)."
  [period-ms f]
  (let [running (atom true)]
    (future
      (loop []
        (sleep-ms! period-ms)
        (when @running
          (try (f) (catch Throwable _ nil))
          (recur))))
    running))

(defn stop-timer! [h]
  (when h (reset! h false)))

(def ^:private exit-hooks (atom []))

(defn on-process-exit!
  "let-go gives a program no exit hook (no atexit/exit native in eve.native,
   no hook var in let-go's core — checked against the v1.13.0 host surface):
   f is kept, never called — the beam/dart shape for seats with no exit hook.
   The hook eve.atom registers here only releases the domain's worker slot;
   that release rides the heartbeat instead: the slot is freed when its
   heartbeat goes stale (HEARTBEAT_TIMEOUT_MS), as for a killed process, and
   Eve's domains are built to be re-opened after a death (the journal and
   the root publication are atomic), so nothing is lost by the hook never
   firing. (Was: THREW {:eve.process/refused :exit-hooks} — but eve.atom's
   open-mmap-domain! calls this unconditionally, so the throw made every
   disk domain unopenable on :lg; measured, wall L2, go-bodies STATUS-L.)"
  [f]
  (swap! exit-hooks conj f)
  nil)

(defn file-exists? [path] (some? (os/stat path)))

(defn create-exclusive!
  "Create the file at path, empty, if no file is there — one atomic step
   against every other process: true for the process that created it, false
   when it already existed (an mmap domain's creator is the one that gets
   true). lg-eve's native (O_CREAT|O_EXCL)."
  [path]
  (eve.native/create-exclusive! path))

(defn ensure-parent-dir!
  "Create the directory a domain's files live in (the default domain's ./eve/)."
  [base-path]
  (eve.native/ensure-parent-dir! base-path))

(defn identity-hash
  "An object's identity hash: let-go's hash (no address is reachable; eve's reference table tells equal values apart by
   identical?)."
  [x]
  (hash x))

(defn random-bytes
  "n bytes from the operating system's entropy (Go's crypto/rand), as a vector of 0..255"
  [n]
  (eve.host-native/random-bytes (long n)))

(defn read-line
  "the next line of the process's standard input, its line end dropped; nil at the end of the input (one bufio.Reader
   for the process, lg-eve's)"
  []
  (eve.host-native/stdin-line))

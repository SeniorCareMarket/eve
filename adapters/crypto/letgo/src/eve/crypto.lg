(ns eve.crypto
  "eve's crypto feature (adapters/README.md) on let-go (lg-eve): SHA-256, SHA-384, SHA-512, HMAC-SHA256, AES-256-CTR,
   AES-256-GCM, Ed25519 and X25519 are Go's standard library through lg-eve's natives (eve.host-native,
   impls/let-go/evenative/host.go: stock let-go carries SHA-1 and SHA-256 only), Ed25519 verify behind
   eve.net.ed25519/well-formed?; XXH3 is eve.net.portable-crypto's; the big-integer and edwards25519 rows Go's math/big
   through the same natives and eve.net.bigops / eve.net.edwards; random bytes are the process feature's. Bytes are
   vectors of 0..255 in and out. Held to the portable rows by eve/test/eve/net/crypto_fast_path_test.cljc."
  (:require [eve.net.bigops :as bo]
            [eve.net.ed25519 :as ed]
            [eve.net.edwards :as edw]
            [eve.net.portable-crypto :as p]
            [eve.process :as process]))

(defn sha256 "the 32-byte digest (Go's crypto/sha256)" [bs] (eve.host-native/sha256 bs))
(defn hmac-sha256 "RFC 2104 over SHA-256 (crypto/hmac)" [key msg] (eve.host-native/hmac-sha256 key msg))
(defn aes256-ctr "data XOR the AES-256-CTR keystream from the 16-byte iv under a 32-byte key (crypto/cipher)" [key iv data]
  (eve.host-native/aes256-ctr key iv data))
(defn xxh3-128 "the 16-byte XXH3-128 digest, big-endian hi then lo" [bs] (p/xxh3-128 bs))
(defn random-bytes "n bytes of the operating system's entropy" [n] (process/random-bytes n))
(defn ed25519-public-key "the 32-byte public key of a 32-byte secret seed (crypto/ed25519)" [seed]
  (eve.host-native/ed25519-public-key seed))
(defn ed25519-sign "the 64-byte signature of the message under a 32-byte secret seed (crypto/ed25519)" [seed msg]
  (eve.host-native/ed25519-sign seed msg))
(defn ed25519-verify "is sig a valid signature of the message under the 32-byte public key: eve's well-formedness, then crypto/ed25519"
  [pub msg sig] (boolean (and (ed/well-formed? pub sig) (eve.host-native/ed25519-verify pub msg sig))))
(defn sha384 "the 48-byte SHA-384 digest (crypto/sha512)" [bs] (eve.host-native/sha384 bs))

(def ^:private OPS
  (bo/complete
   {:int (fn [n] (eve.host-native/big-int n))
    :from-be (fn [bs] (eve.host-native/big-from-be bs))
    :to-be (fn [x len] (eve.host-native/big-to-be x len))
    :add (fn [a b] (eve.host-native/big-add a b))
    :sub (fn [a b] (eve.host-native/big-sub a b))
    :mul (fn [a b] (eve.host-native/big-mul a b))
    :quot (fn [a b] (eve.host-native/big-quot a b))
    :mod (fn [a m] (eve.host-native/big-mod a m))
    :modpow (fn [b e m] (eve.host-native/big-modpow b e m))
    :even? (fn [a] (= 0 (eve.host-native/big-bit0 a)))
    :zero? (fn [a] (= 0 (eve.host-native/big-cmp a 0)))
    :eq (fn [a b] (= 0 (eve.host-native/big-cmp a b)))}))
(def ^:private ED (edw/make OPS))
(defn modpow "base^exp mod n over big-endian bytes; the result is as long as n" [base exp n] (bo/modpow-bytes OPS base exp n))
(defn modmul "a·b mod n over big-endian bytes; the result is as long as n" [a b n] (bo/modmul-bytes OPS a b n))
(defn modinv "a^-1 mod n over big-endian bytes, or nil when gcd(a, n) ≠ 1" [a n] (bo/modinv-bytes OPS a n))
(defn ed25519-scalarmult "the encoding of [s]P: s 32 little-endian bytes, P a 32-byte encoding" [s p] ((:scalarmult ED) s p))
(defn ed25519-mul-add "the encoding of [a]P + [b]Q" [a p b q] ((:mul-add ED) a p b q))
(defn x25519 "X25519 (RFC 7748): the 32-byte u-coordinate of [k]u, k and u 32 little-endian bytes (crypto/ecdh)" [k u]
  (eve.host-native/x25519 k u))
(defn sha512 "the 64-byte SHA-512 digest (crypto/sha512)" [bs] (eve.host-native/sha512 bs))
(defn aes256-gcm-seal "AES-256-GCM: ciphertext ‖ 16-byte tag (crypto/cipher)" [key iv aad pt]
  (eve.host-native/aes256-gcm-seal key iv aad pt))
(defn aes256-gcm-open "the plaintext of AES-256-GCM ciphertext ‖ tag, or nil (crypto/cipher)" [key iv aad sealed]
  (eve.host-native/aes256-gcm-open key iv aad sealed))

(defn ed25519-map-to-point
  "the 32-byte encoding of clear_cofactor(map_to_curve(u0) + map_to_curve(u1)) on edwards25519 (RFC 9380 G.2.1–G.2.2),
   u0 and u1 32 little-endian bytes (bit 255 dropped) — eve.net.portable-crypto's map over this adapter's modpow"
  [u0 u1]
  (p/ed25519-map-to-point u0 u1 modpow))

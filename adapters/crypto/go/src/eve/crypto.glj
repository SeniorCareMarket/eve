(ns eve.crypto
  "eve's crypto feature (adapters/README.md) on glojure (glj-eve): SHA-256, SHA-384, SHA-512, HMAC-SHA256,
   AES-256-CTR, AES-256-GCM, Ed25519 and X25519 are Go's standard library through eve's Go host package
   (impls/glojure/host/crypto.go, compiled into glj-eve: stock glj exposes no crypto packages), Ed25519 verify behind
   eve.net.ed25519/well-formed?; XXH3 is eve.net.portable-crypto's; the big-integer and edwards25519 rows Go's
   math/big (which glojure does expose: NewInt, Exp, SetString / Text for the byte conversions; the inverse is bigops' extended Euclid — big.Int's ModInverse answers a Go nil pointer glojure cannot test for) through
   eve.net.bigops / eve.net.edwards; random bytes are the process feature's. Bytes are vectors of 0..255 in and out.
   Held to the portable rows by eve/test/eve/net/crypto_fast_path_test.cljc."
  (:require [eve.net.bigops :as bo]
            [eve.net.ed25519 :as ed]
            [eve.net.edwards :as edw]
            [eve.net.portable-crypto :as p]
            [eve.process :as process]))

(defn sha256 "the 32-byte digest (Go's crypto/sha256)" [bs] (eveglj:host.Sha256 bs))
(defn hmac-sha256 "RFC 2104 over SHA-256 (crypto/hmac)" [key msg] (eveglj:host.HmacSha256 key msg))
(defn aes256-ctr "data XOR the AES-256-CTR keystream from the 16-byte iv under a 32-byte key (crypto/cipher)" [key iv data] (eveglj:host.Aes256Ctr key iv data))
(defn xxh3-128 "the 16-byte XXH3-128 digest, big-endian hi then lo" [bs] (p/xxh3-128 bs))
(defn random-bytes "n bytes of the operating system's entropy" [n] (process/random-bytes n))
(defn ed25519-public-key "the 32-byte public key of a 32-byte secret seed (crypto/ed25519)" [seed] (eveglj:host.Ed25519PublicKey seed))
(defn ed25519-sign "the 64-byte signature of the message under a 32-byte secret seed (crypto/ed25519)" [seed msg] (eveglj:host.Ed25519Sign seed msg))
(defn ed25519-verify "is sig a valid signature of the message under the 32-byte public key: eve's well-formedness, then crypto/ed25519"
  [pub msg sig] (boolean (and (ed/well-formed? pub sig) (eveglj:host.Ed25519Verify pub msg sig))))
(defn sha384 "the 48-byte SHA-384 digest (crypto/sha512)" [bs] (eveglj:host.Sha384 bs))

(def ^:private HEX "0123456789abcdef")
(defn- hex-of [bs] (apply str (map (fn [b] (str (nth HEX (quot b 16)) (nth HEX (mod b 16)))) bs)))
(defn- hex-digit [c] (let [i (clojure.string/index-of HEX (clojure.string/lower-case (str c)))] i))
(defn- big [bs] (first (.SetString (math:big.NewInt 0) (str "0" (hex-of bs)) 16)))
(defn- unbig "the big-endian len bytes of a non-negative big.Int" [x len]
  (let [h (.Text x 16)
        h (if (odd? (count h)) (str "0" h) h)
        v (vec (map (fn [i] (+ (* 16 (hex-digit (nth h i))) (hex-digit (nth h (inc i))))) (range 0 (count h) 2)))
        v (if (> (count v) len) (subvec v (- (count v) len)) v)]
    (into (vec (repeat (- len (count v)) 0)) v)))
(def ^:private OPS
  (bo/complete
   {:int (fn [n] (math:big.NewInt n))
    :from-be big :to-be unbig
    :add (fn [a b] (.Add (math:big.NewInt 0) a b))
    :sub (fn [a b] (.Sub (math:big.NewInt 0) a b))
    :mul (fn [a b] (.Mul (math:big.NewInt 0) a b))
    :quot (fn [a b] (.Quo (math:big.NewInt 0) a b))
    :mod (fn [a m] (.Mod (math:big.NewInt 0) a m))
    :modpow (fn [b e m] (.Exp (math:big.NewInt 0) b e m))
    :even? (fn [a] (= 0 (.Bit a 0))) :zero? (fn [a] (= 0 (.Sign a))) :eq (fn [a b] (= 0 (.Cmp a b)))}))
(def ^:private ED (edw/make OPS))
(defn modpow "base^exp mod n over big-endian bytes; the result is as long as n" [base exp n] (bo/modpow-bytes OPS base exp n))
(defn modmul "a·b mod n over big-endian bytes; the result is as long as n" [a b n] (bo/modmul-bytes OPS a b n))
(defn modinv "a^-1 mod n over big-endian bytes, or nil when gcd(a, n) ≠ 1" [a n] (bo/modinv-bytes OPS a n))
(defn ed25519-scalarmult "the encoding of [s]P: s 32 little-endian bytes, P a 32-byte encoding" [s p] ((:scalarmult ED) s p))
(defn ed25519-mul-add "the encoding of [a]P + [b]Q" [a p b q] ((:mul-add ED) a p b q))
(defn x25519 "X25519 (RFC 7748): the 32-byte u-coordinate of [k]u, k and u 32 little-endian bytes (crypto/ecdh)" [k u] (eveglj:host.X25519 k u))
(defn sha512 "the 64-byte SHA-512 digest (crypto/sha512)" [bs] (eveglj:host.Sha512 bs))
(defn aes256-gcm-seal "AES-256-GCM: ciphertext ‖ 16-byte tag (crypto/cipher)" [key iv aad pt] (eveglj:host.Aes256GcmSeal key iv aad pt))
(defn aes256-gcm-open "the plaintext of AES-256-GCM ciphertext ‖ tag, or nil (crypto/cipher)" [key iv aad sealed] (eveglj:host.Aes256GcmOpen key iv aad sealed))

(defn ed25519-map-to-point
  "the 32-byte encoding of clear_cofactor(map_to_curve(u0) + map_to_curve(u1)) on edwards25519 (RFC 9380 G.2.1–G.2.2),
   u0 and u1 32 little-endian bytes (bit 255 dropped) — eve.net.portable-crypto's map over this adapter's modpow"
  [u0 u1]
  (p/ed25519-map-to-point u0 u1 modpow))

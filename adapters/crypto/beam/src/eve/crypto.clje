(ns eve.crypto
  "eve's crypto feature (adapters/README.md) over OTP's crypto module — clojerl: SHA-256 (crypto:hash), HMAC-SHA256
   (crypto:mac), AES-256-CTR (crypto:crypto_one_time aes_256_ctr: OpenSSL's, the whole 16-byte counter incremented
   big-endian, as SP 800-38A F.5.5 and eve.net.aes), Ed25519 (crypto:generate_key / sign / verify with eddsa; verify
   first refuses what eve.net.ed25519/well-formed? refuses), SHA-512, AES-256-GCM (crypto:crypto_one_time_aead
   aes_256_gcm), X25519 (crypto:compute_key ecdh x25519). OTP has no XXH3: that one is eve.net.portable-crypto's;
   random bytes are the process feature's (crypto:strong_rand_bytes). Bytes are vectors of 0..255 in and out;
   eve/test/eve/net/crypto_test.cljc holds this adapter to the portable code."
  (:require [eve.net.bigops :as bo]
            [eve.net.edwards :as edw]
            [eve.net.portable-crypto :as p]
            [eve.net.ed25519 :as ed]
            [eve.process :as process]))

(defn- bin [bs] (erlang/list_to_binary (clj->erl (apply list bs))))
(defn- v [b] (vec (erlang/binary_to_list b)))

(defn sha256 "the 32-byte digest" [bs] (v (crypto/hash :sha256 (bin bs))))

(defn hmac-sha256 "RFC 2104 over SHA-256" [key msg] (v (crypto/mac :hmac :sha256 (bin key) (bin msg))))

(defn aes256-ctr "data XOR the AES-256-CTR keystream from the 16-byte iv under a 32-byte key" [key iv data]
  (v (crypto/crypto_one_time :aes_256_ctr (bin key) (bin iv) (bin data) true)))

(defn xxh3-128 "the 16-byte XXH3-128 digest, big-endian hi then lo (portable: OTP has none)" [bs] (p/xxh3-128 bs))
(defn random-bytes "n bytes of the operating system's entropy" [n] (process/random-bytes n))

(defn- seed-bin [seed]
  (let [seed (vec seed)]
    (when-not (= 32 (count seed))
      (throw (ex-info (str "ed25519: a seed is 32 bytes, not " (count seed)) {:count (count seed)})))
    (bin seed)))

(defn ed25519-public-key "the 32-byte public key of a 32-byte secret seed" [seed]
  (v (erlang/element 1 (crypto/generate_key :eddsa :ed25519 (seed-bin seed)))))

(defn ed25519-sign "the 64-byte signature of the message under a 32-byte secret seed" [seed msg]
  ;; the key is a list [key curve]: clj->erl makes a vector a tuple, which OTP refuses
  (v (crypto/sign :eddsa :none (bin msg) (clj->erl (list (seed-bin seed) :ed25519)))))

(defn ed25519-verify "is sig a valid signature of the message under the 32-byte public key" [pub msg sig]
  (boolean
   (and (ed/well-formed? pub sig)
        (try (= true (crypto/verify :eddsa :none (bin msg) (bin sig) (clj->erl (list (bin pub) :ed25519))))
             ;; a key that decodes to no point
             (catch _ _ false)))))

;; ── the aegis clear-evaluation rows: SHA-384 (crypto:hash), the big-integer and edwards25519
;; rows over Erlang's integers (arbitrary precision; crypto:mod_pow for the exponentiation, which answers a binary
;; without leading zeros) through eve.net.bigops / eve.net.edwards. Proven on clojerl (OTP 25): REPORT.md §8.
(defn- int-of-bin [b] (reduce (fn [acc x] (+ (* acc 256) x)) 0 (erlang/binary_to_list b)))
(defn- ops
  "the OPS map, built per call: clojerl compiles a def's value as a literal, and a map of functions is none"
  []
  (bo/complete
   {:int (fn [n] n)
    :from-be (fn [bs] (reduce (fn [acc b] (+ (* acc 256) b)) 0 bs))
    :to-be (fn [x len] (bo/to-be-by {:int identity :mod mod :quot quot} identity x len))
    :add + :sub - :mul * :quot quot
    :mod (fn [a m] (let [r (rem a m)] (if (neg? r) (+ r m) r)))
    :modpow (fn [b e m] (int-of-bin (crypto/mod_pow b e m)))
    :even? even? :zero? zero? :eq =}))
(defn- ed [] (edw/make (ops)))
(defn sha384 "the 48-byte SHA-384 digest" [bs] (v (crypto/hash :sha384 (bin bs))))
(defn modpow "base^exp mod n over big-endian bytes; the result is as long as n" [base exp n] (bo/modpow-bytes (ops) base exp n))
(defn modmul "a·b mod n over big-endian bytes; the result is as long as n" [a b n] (bo/modmul-bytes (ops) a b n))
(defn modinv "a^-1 mod n over big-endian bytes, or nil when gcd(a, n) ≠ 1" [a n] (bo/modinv-bytes (ops) a n))
(defn ed25519-scalarmult "the encoding of [s]P: s 32 little-endian bytes, P a 32-byte encoding" [s p] ((:scalarmult (ed)) s p))
(defn ed25519-mul-add "the encoding of [a]P + [b]Q" [a p b q] ((:mul-add (ed)) a p b q))
(defn x25519 "X25519 (RFC 7748): the 32-byte u-coordinate of [k]u, k and u 32 little-endian bytes (crypto:compute_key;
   OTP refuses a low-order u: the all-zero output then, as the portable ladder computes it)" [k u]
  (try (v (crypto/compute_key :ecdh (bin u) (bin k) :x25519))
       (catch _ _ (vec (repeat 32 0)))))
(defn sha512 "the 64-byte SHA-512 digest" [bs] (v (crypto/hash :sha512 (bin bs))))
(defn aes256-gcm-seal "AES-256-GCM (crypto:crypto_one_time_aead): ciphertext ‖ 16-byte tag" [key iv aad pt]
  (let [r (crypto/crypto_one_time_aead :aes_256_gcm (bin key) (bin iv) (bin pt) (bin aad) true)]
    (into (v (erlang/element 1 r)) (v (erlang/element 2 r)))))
(defn aes256-gcm-open "the plaintext of AES-256-GCM ciphertext ‖ tag, or nil when it does not authenticate" [key iv aad sealed]
  (let [s (vec sealed) n (- (count s) 16)]
    (when (>= n 0)
      (let [r (crypto/crypto_one_time_aead :aes_256_gcm (bin key) (bin iv) (bin (subvec s 0 n)) (bin aad) (bin (subvec s n)) false)]
        (when (erlang/is_binary r) (v r))))))

(defn ed25519-map-to-point
  "the 32-byte encoding of clear_cofactor(map_to_curve(u0) + map_to_curve(u1)) on edwards25519 (RFC 9380 G.2.1–G.2.2),
   u0 and u1 32 little-endian bytes (bit 255 dropped) — eve.net.portable-crypto's map over this adapter's modpow"
  [u0 u1]
  (p/ed25519-map-to-point u0 u1 modpow))

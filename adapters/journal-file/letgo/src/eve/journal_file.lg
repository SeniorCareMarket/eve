(ns eve.journal-file
  "The commit journal's file (eve.atom's durability mode): an append-only
   per-domain file beside the domain root, holding commit records only.
   This host: let-go — lg-eve's fd natives (eve.native: pread/pwrite/
   ftruncate/fsync/fdatasync over a plain file descriptor), its fcntl
   byte-range lock for the journal lock, and its CRC-32. A handle is
   {:fd fd :busy atom}: the busy flag is this process's monitor (POSIX
   locks do not exclude a process from itself), the fcntl lock on the
   whole file excludes every other process.

   Record format (identical bytes on every host):
     [magic i32][len i32][epoch i32][table-len i32][table bytes][crc32 i32]
   magic = \"EVJ1\" (0x45564A31); all integers big-endian; len counts the
   bytes after itself (epoch + table-len + table + crc); the CRC-32
   covers the epoch..table-end bytes. The commit point is lock, write
   blocks, force slab, append record, force journal — eve.atom runs
   that sequence over this file."
  (:require [eve.mem :as mem]
            [eve.deftype-proto.data :as d]))

(def ^:private journal-magic 0x45564A31)        ;; "EVJ1"
(def ^:private journal-table-bytes (* d/MAX_ATOM_SLOTS d/ATOM_SLOT_SIZE))

;; big-endian i32 over a let-go byte-array (aget answers a signed byte)
(defn- put-i32! [b off v]
  (aset b off (unchecked-byte (bit-shift-right v 24)))
  (aset b (+ off 1) (unchecked-byte (bit-shift-right v 16)))
  (aset b (+ off 2) (unchecked-byte (bit-shift-right v 8)))
  (aset b (+ off 3) (unchecked-byte v)))

(defn- get-i32 [b off]
  (let [u (bit-or (bit-shift-left (bit-and (aget b off) 0xFF) 24)
                  (bit-shift-left (bit-and (aget b (+ off 1)) 0xFF) 16)
                  (bit-shift-left (bit-and (aget b (+ off 2)) 0xFF) 8)
                  (bit-and (aget b (+ off 3)) 0xFF))]
    (if (>= u 2147483648) (- u 4294967296) u)))

(defn- copy-bytes
  "A new byte-array holding src[from, from+n)."
  [src from n]
  (let [out (byte-array n)]
    (loop [i 0]
      (when (< i n)
        (aset out i (aget src (+ from i)))
        (recur (inc i))))
    out))

(defn open-journal
  "Open (creating if needed) the journal file at PATH for read+write."
  [path]
  {:fd (eve.native/fd-open path) :busy (atom false)})

(defn with-journal-lock
  "Run F holding the journal file's exclusive lock: this process's busy
   flag first (POSIX locks do not exclude their own process), then the
   fcntl write lock on the whole file (range [0, 0) — to the file's end,
   however it grows)."
  [h f]
  (let [busy (:busy h)]
    (loop []
      (when-not (compare-and-set! busy false true)
        (eve.host-native/sleep-ms 1)
        (recur)))
    (try
      (eve.native/lock! (:fd h) 0 0)
      (try (f)
           (finally (eve.native/unlock! (:fd h) 0 0)))
      (finally (reset! busy false)))))

(defn journal-record-of
  "The commit record for an explicit EPOCH and TABLE (byte array), as a
   byte array."
  [epoch table]
  (let [tlen (alength table)
        len (+ 4 4 tlen 4)
        rec (byte-array (+ 8 len))]
    (put-i32! rec 0 journal-magic)
    (put-i32! rec 4 len)
    (put-i32! rec 8 epoch)
    (put-i32! rec 12 tlen)
    (eve.native/write-bytes! rec 16 table)
    (put-i32! rec (+ 16 tlen)
              (unchecked-int (eve.native/crc32 (eve.native/read-bytes rec 8 (+ 4 4 tlen)))))
    rec))

(defn journal-record
  "The commit record for ROOT-R's CURRENT epoch and atom table."
  [root-r]
  (journal-record-of (mem/-load-i32 root-r d/ROOT_EPOCH_OFFSET)
                     (mem/-read-bytes root-r d/ATOM_TABLE_START journal-table-bytes)))

(defn journal-scan
  "Scan the journal's records in order. Returns {:newest {:epoch :table}
   :oldest epoch :torn? bool} — a record is accepted iff its framing
   survives (magic + length in range) and its CRC matches; a record
   whose framing survives but whose CRC fails is SKIPPED (its length
   still advances the scan — a dead earlier writer must not hide a
   later good record from any host); a framing failure ends the scan."
  [h]
  (let [size (eve.native/fd-size (:fd h))]
    (if (zero? size)
      {:newest nil :oldest nil :torn? false}
      (let [buf (eve.native/fd-read-at (:fd h) 0 size)]
        (loop [pos 0 newest nil oldest nil torn? false]
          (let [remaining (- size pos)]
            (if (< remaining 8)
              {:newest newest :oldest oldest
               :torn? (or torn? (pos? remaining))}
              (let [magic (get-i32 buf pos)
                    len (get-i32 buf (+ pos 4))]
                (if (or (not= magic journal-magic)
                        (not (pos? len))
                        (> len (- remaining 8)))
                  {:newest newest :oldest oldest :torn? true}
                  (let [epoch (get-i32 buf (+ pos 8))
                        tlen (get-i32 buf (+ pos 12))]
                    (if (> (+ 4 4 tlen 4) len)
                      ;; a table length that cannot fit its own
                      ;; record: the tail is torn beyond framing.
                      {:newest newest :oldest oldest :torn? true}
                      (let [stored (get-i32 buf (+ pos 16 tlen))
                            crc (eve.native/crc32 (eve.native/read-bytes buf (+ pos 8) (+ 4 4 tlen)))]
                        (if (= stored (unchecked-int crc))
                          (recur (+ pos 8 len)
                                 {:epoch epoch :table (copy-bytes buf (+ pos 16) tlen)}
                                 (or oldest epoch)
                                 torn?)
                          (recur (+ pos 8 len) newest oldest true))))))))))))))

(defn journal-append!
  "Write BYTES (a byte array) at the end of the journal file. Does not
   force — the caller forces at the commit point."
  [h bytes]
  (eve.native/fd-write-at! (:fd h) bytes (eve.native/fd-size (:fd h)))
  nil)

(defn journal-write-at!
  "Write BYTES (a byte array) at absolute offset POS."
  [h bytes pos]
  (eve.native/fd-write-at! (:fd h) bytes pos)
  nil)

(defn journal-truncate!
  "Truncate the journal file to zero length (no force; the caller
   forces as part of its checkpoint/recovery sequence)."
  [h]
  (eve.native/fd-truncate! (:fd h) 0)
  nil)

(defn journal-force!
  "Force the journal file to storage. FULL? true includes file metadata
   (a truncate/checkpoint boundary); false is the append path's
   data+size force."
  [h full?]
  (eve.native/fd-sync! (:fd h) full?)
  nil)

(defn journal-close!
  "Close the journal file; never throws."
  [h]
  (try
    (eve.native/fd-close! (:fd h))
    (catch Throwable _ nil))
  nil)

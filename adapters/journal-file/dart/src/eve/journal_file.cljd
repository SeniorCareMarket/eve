(ns eve.journal-file
  "The commit journal's file handle (eve.atom's durability mode): an
   append-only per-domain file beside the domain root, holding commit
   records only. This host: ClojureDart — a dart:io RandomAccessFile
   opened in append mode; the journal's lock is a lock DIRECTORY beside
   the file (Directory.createSync is the atomic test-and-set, as
   journal-file/node's mkdir is; it excludes the other hosts' seats
   only through the same directory protocol).

   Record format (identical bytes on every host):
     [magic i32][len i32][epoch i32][table-len i32][table bytes][crc32 i32]
   magic = \"EVJ1\" (0x45564A31); all integers big-endian; len counts the
   bytes after itself (epoch + table-len + table + crc); the CRC-32
   covers the epoch..table-end bytes. The commit point is lock, write
   blocks, force slab, append record, force journal — eve.atom runs
   that sequence over this file.

   journal-write-at! is called by eve.atom only at offset 0 immediately
   after a truncate (the checkpoint rewrite), where append-mode's
   write-at-end and write-at-0 are the same bytes; the scan reads by
   path, as node's does, so the append-mode handle needs no read side."

  ;; this namespace's per-seat defs are in the central config's
  ;; :unresolved-var exclusions (.clj-kondo/config.edn): one namespace
  ;; lives in several seat files and kondo's registry keeps one file's
  ;; defs, reading the others' as unresolved.

  (:require ["dart:io" :as io]
            ["dart:typed_data" :as td]
            [eve.mem :as mem]
            [eve.deftype-proto.data :as d]))

(def ^:private journal-magic 0x45564A31)   ;; "EVJ1"
(def ^:private journal-table-bytes (* d/max-atom-slots d/atom-slot-size))

;; CRC-32 (IEEE), the journal record's checksum (journal-file/node's table).
;; A Uint32List, not Int32List: Dart's ints are 64-bit, and an Int32List
;; read sign-extends — a table entry >= 2^31 would poison the running
;; CRC's high bits on every step (JS's i32 bitwise ops hide this there).
(def ^:private crc-table
  (let [t (td/Uint32List 256)]
    (dotimes [n 256]
      (loop [c n i 0]
        (if (< i 8)
          (recur (if (zero? (bit-and c 1))
                   (unsigned-bit-shift-right c 1)
                   (bit-xor 0xEDB88320 (unsigned-bit-shift-right c 1)))
                 (inc i))
          (aset t n c))))
    t))

#_{:clj-kondo/ignore [:type-mismatch]} ; the tables are Dart typed arrays (Uint8List); kondo's aget expects its own array type - a .cljd modeling gap, the seat's aget is the typed-array read
(defn- crc32-of
  "CRC-32 of the byte array SUB from OFF for LEN bytes, as a signed i32."
  [sub off len]
  (loop [c 0xFFFFFFFF i 0]
    (if (< i len)
      (recur (bit-xor (unsigned-bit-shift-right c 8)
                      (aget crc-table (bit-and (bit-xor c (aget sub (+ off i))) 0xFF)))
             (inc i))
      (bit-xor c 0xFFFFFFFF))))

(defn open-journal
  "Open (creating if needed) the journal file at PATH for append.
   Returns the file handle {:raf :path}."
  [path]
  {:raf (.openSync (io/File path) :mode io/FileMode.append) :path path})

(defn with-journal-lock
  "Run F holding the journal's lock: the .journal.lock directory beside
   the journal file (createSync is atomic test-and-set). Spins with a
   short sleep on contention. A holder that dies leaves the directory;
   stale-lock recovery is the same heartbeat question as the domain's
   and out of scope — the lock is only ever held for one flush's
   duration."
  [{:keys [path]} f]
  (let [dir (io/Directory (str path ".lock"))]
    (loop [tries 0]
      (let [got (try (.createSync dir) true (catch dynamic _ false))]
        (cond got (try (f) (finally (try (.deleteSync dir) (catch dynamic _ nil))))
              (> tries 6000) (throw (ex-info "journal lock timeout" {:dir (.-path dir)}))
              :else (do (io/sleep (Duration .milliseconds 5)) (recur (inc tries))))))))

(defn- record-bytes
  "The commit record for EPOCH and TABLE (a byte array): a host byte array."
  [epoch tbl]
  (let [len (+ 4 4 (.-length tbl) 4)
        out (td/Uint8List (+ 8 len))
        dv (td/ByteData.view (.-buffer out))]
    (.setInt32 dv 0 journal-magic)
    (.setInt32 dv 4 len)
    (.setInt32 dv 8 epoch)
    (.setInt32 dv 12 (.-length tbl))
    (.setRange out 16 (+ 16 (.-length tbl)) tbl)
    (.setInt32 dv (+ 16 (.-length tbl)) (crc32-of out 8 (+ 4 4 (.-length tbl))))
    (.asInt8List (.-buffer out) 0 (.-length out))))

(defn journal-record
  "The commit record for ROOT-R's CURRENT epoch and atom table, as a
   byte array."
  [root-r]
  (record-bytes (mem/-load-i32 root-r d/root-epoch-offset)
                (mem/-read-bytes root-r d/atom-table-start journal-table-bytes)))

(defn journal-record-of
  "The commit record for an explicit EPOCH and TABLE (a byte array)."
  [epoch tbl]
  (record-bytes epoch tbl))

(defn journal-scan
  "Scan the journal's records in order. Returns {:newest {:epoch :table}
   :oldest epoch :torn? bool} — a record is accepted iff its framing
   survives (magic + length in range) and its CRC matches; a record whose
   framing survives but whose CRC fails is SKIPPED (its length still
   advances the scan); a framing failure ends the scan."
  [{:keys [path]}]
  (let [^td/Uint8List data (try (.readAsBytesSync (io/File path))
                                (catch dynamic _ (td/Uint8List 0)))
        dv (td/ByteData.view (.-buffer data) (.-offsetInBytes data) (.-length data))
        total (.-length data)]
    (loop [pos 0 newest nil oldest nil torn? false]
      (let [remaining (- total pos)]
        (cond
          (< remaining 8) {:newest newest :oldest oldest
                           :torn? (or torn? (pos? remaining))}
          :else
          (let [magic (.getInt32 dv pos)
                len (.getInt32 dv (+ pos 4))]
            (if (or (not= magic journal-magic)
                    (not (pos? len))
                    (> len (- remaining 8)))
              {:newest newest :oldest oldest :torn? true}
              (let [epoch (.getInt32 dv (+ pos 8))
                    tlen (.getInt32 dv (+ pos 12))]
                (if (> (+ 4 4 tlen 4) len)
                  {:newest newest :oldest oldest :torn? true}
                  (let [tbl (.asInt8List (.-buffer data)
                                         (+ (.-offsetInBytes data) pos 16) tlen)]
                    (if (= (bit-and (.getInt32 dv (+ pos 16 tlen)) 0xFFFFFFFF)
                           (crc32-of data (+ pos 8) (+ 4 4 tlen)))
                      (recur (+ pos 8 len) {:epoch epoch :table tbl}
                             (or oldest epoch) torn?)
                      (recur (+ pos 8 len) newest oldest true))))))))))))

(defn journal-append!
  "Write BYTES at the end of the journal file (the handle is in append
   mode). Does not force — the caller forces at the commit point."
  [{:keys [raf]} bytes]
  (.writeFromSync raf bytes))

(defn journal-write-at!
  "Write BYTES at absolute offset POS (eve.atom calls this only at 0,
   after a truncate — see the namespace's note)."
  [{:keys [raf]} bytes pos]
  (.setPositionSync raf pos)
  (.writeFromSync raf bytes))

(defn journal-truncate!
  "Truncate the journal file to zero length (no force; the caller
   forces as part of its checkpoint/recovery sequence)."
  [{:keys [raf]}]
  (.truncateSync raf 0))

(defn journal-force!
  "Force the journal file to storage. flushSync is an fsync — FULL? is
   ignored (the stronger force is taken on both paths, as node's is)."
  [{:keys [raf]} _full?]
  (.flushSync raf))

(defn journal-close!
  "Close the journal file; never throws."
  [{:keys [raf]}]
  (try (.closeSync raf) (catch dynamic _ nil)))

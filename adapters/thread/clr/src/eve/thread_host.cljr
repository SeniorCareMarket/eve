(ns eve.thread-host
  "eve's thread feature (HOST-CONTRACT §11) over .NET's System.Threading (ClojureCLR): a thread is a background
   Thread, its mailbox a queue under a monitor (Monitor.Wait / Pulse: BlockingCollection's timed take needs an out
   parameter); threads share one heap, so a message carries closures and host values by reference and the binding
   frame is ClojureCLR's own (get-thread-bindings). A started thread's end, normal or not, is a message to the thread
   that started it.")

(def ^:private boxes
  "address → that thread's mailbox {:lock :q}, while the thread runs."
  (atom {}))
(def ^:private addr-of
  "managed thread id → address, for the threads that have one."
  (atom {}))
(def ^:private next-id (atom 0))

(defn- box! []
  (let [id (swap! next-id inc)]
    (swap! boxes assoc id {:lock (Object.) :q (atom clojure.lang.PersistentQueue/EMPTY)})
    id))

(defn- thread-key [] (.ManagedThreadId System.Threading.Thread/CurrentThread))

(defn parallelism [] Environment/ProcessorCount)

(defn ships-closures? [] true)

(defn driving
  "The declared driving properties: a blocked waiter costs an OS thread; threads run in parallel; eve's CLR region
   waits on a futex."
  []
  {:block :thread :parallel true :closures true :eval true :wake :futex
   :spawn-ms 0 :max-threads nil :runtime :cljr})

(defn self
  "The calling thread's address (a thread this adapter did not start gets one on first call)."
  []
  (let [k (thread-key)]
    (or (get @addr-of k)
        (let [id (box!)] (swap! addr-of assoc k id) id))))

(defn error-data [e] {:class (.FullName (class e)) :message (ex-message e) :data (ex-data e)})

(defn send!
  "Enqueue msg for the thread at addr; never blocks. A thread that has ended has no mailbox: the message is dropped."
  [addr msg]
  (when-let [{:keys [lock q]} (get @boxes addr)]
    (locking lock
      (swap! q conj msg)
      (System.Threading.Monitor/Pulse lock)))
  nil)

(defn start-threads!
  "Start n threads, each running ((resolve entry) (assoc boot :self addr)); their addresses. opts: :name. When a
   thread's entry ends — it returned, or threw — its starter receives {:eve.thread/exit addr :reason r}: r :normal,
   or the error as error-data."
  [n entry boot opts]
  (require (symbol (namespace entry)))
  (let [f (resolve entry)
        starter (self)
        tname (or (:name opts) "eve-thread")]
    (vec (for [i (range n)]
           (let [id (box!)
                 t (System.Threading.Thread.
                    (gen-delegate System.Threading.ThreadStart []
                      (let [k (thread-key)]
                        (swap! addr-of assoc k id)
                        (let [reason (try (f (assoc boot :self id)) :normal
                                          (catch Exception e (error-data e)))]
                          (swap! boxes dissoc id)
                          (swap! addr-of dissoc k)
                          (send! starter {:eve.thread/exit id :reason reason})))))]
             (set! (.IsBackground t) true)
             (set! (.Name t) (str tname "-" i))
             (.Start t)
             id)))))

(defn receive!
  "The calling thread's next message; :eve.thread/timeout after ms milliseconds (ms < 0: wait for ever; 0: poll)."
  [ms]
  (let [{:keys [lock q]} (get @boxes (self))
        deadline (when (pos? ms) (+ (.ToUnixTimeMilliseconds DateTimeOffset/UtcNow) ms))]
    (locking lock
      (loop []
        (if-let [m (peek @q)]
          (do (swap! q pop) m)
          (cond (zero? ms) :eve.thread/timeout
                (neg? ms) (do (System.Threading.Monitor/Wait lock) (recur))
                :else (let [left (- deadline (.ToUnixTimeMilliseconds DateTimeOffset/UtcNow))]
                        (if (<= left 0)
                          :eve.thread/timeout
                          (do (System.Threading.Monitor/Wait lock (int left)) (recur))))))))))

(defn stop-threads!
  "Ask each thread to end: the message :eve.thread/stop (a request its loop honours, never a kill)."
  [addrs]
  (doseq [a addrs] (send! a :eve.thread/stop)))

(defn attempt [f] (try [true (f)] (catch Exception e [false e])))

(defn capture-frame [] (get-thread-bindings))
(defn call-with-frame [frame f] (if frame (with-bindings* frame f) (f)))

(defn var-symbol [v] (let [m (meta v)] (symbol (str (ns-name (:ns m))) (str (:name m)))))

(defn eval-form [form] (eval form))

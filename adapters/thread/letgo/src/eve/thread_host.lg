(ns eve.thread-host
  "eve's thread feature (HOST-CONTRACT §11) over let-go's goroutines: a
   thread is a goroutine started by future — what eve.process's timer
   already runs on — each with its own mailbox (an atom holding a queue
   and, while its thread waits, a promise the next sender delivers;
   let-go's core has no blocking queue). One Go heap: a message carries
   closures and host values by reference.

   The honest limits, declared rather than papered over: let-go conveys
   no binding frame between goroutines (eve.host-completion's
   get-thread-bindings answers {} and with-bindings* runs its function
   in the caller's frame), so a thread starts with the root frame, as a
   JVM thread does; *self* below is bound inside each goroutine it
   starts, never carried into one. A started thread's end, normal or
   not, is a message to the thread that started it."
  (:require [eve.process :as proc]))

(def ^:private boxes
  "address → that thread's mailbox (an atom of {:q :w}), while the thread runs."
  (atom {}))
(def ^:private next-id (atom 0))

(def ^:dynamic ^:private *self*
  "The calling goroutine's address: bound by each goroutine this adapter starts (and kept out of captured frames)."
  nil)

(defn- box! []
  (let [id (swap! next-id inc)]
    (swap! boxes assoc id (atom {:q [] :w nil}))
    id))

(def ^:private main-addr (box!))

(defn parallelism [] (eve.native/num-cpu))

(defn ships-closures? [] true)

(defn driving
  "The declared driving properties: a blocked goroutine costs little;
   goroutines run in parallel on every core; let-go's regions wait and
   notify by the futex syscall on the mapping (eve.region,
   adapters/region/letgo): waits are indefinite and wake exactly on
   notify, never a poll."
  []
  {:block :cheap :parallel true :closures true :eval true :wake :futex
   :spawn-ms 0 :max-threads nil :runtime :lg})

(defn self [] (or *self* main-addr))

(defn error-data [e]
  {:class (str (type e)) :message (ex-message e) :data (ex-data e)})

(defn send!
  "Enqueue msg for the thread at addr; never blocks. A thread that has ended has no mailbox: the message is dropped."
  [addr msg]
  (when-let [b (get @boxes addr)]
    (swap! b update :q conj msg)
    (when-let [w (:w @b)] (deliver w true)))
  nil)

(defn start-threads!
  "Start n goroutines, each running ((resolve entry) (assoc boot :self addr)); their addresses. When a thread's entry
   ends — it returned, or threw — its starter receives {:eve.thread/exit addr :reason r}: r :normal, or the error as
   error-data."
  [n entry boot _opts]
  (let [f (requiring-resolve entry)
        starter (self)]
    (vec (for [_ (range n)]
           (let [id (box!)]
             (future
               (binding [*self* id]
                 (let [reason (try (f (assoc boot :self id)) :normal
                                   (catch Throwable e (error-data e)))]
                   (swap! boxes dissoc id)
                   (send! starter {:eve.thread/exit id :reason reason}))))
             id)))))

(defn receive!
  "The calling thread's next message; :eve.thread/timeout after ms milliseconds (ms < 0: wait for ever; 0: poll)."
  [ms]
  (let [b (get @boxes (self))
        deadline (when (pos? ms) (+ (proc/now-ms) ms))]
    (loop []
      (let [cur @b]
        (if-let [m (first (:q cur))]
          (if (compare-and-set! b cur (assoc cur :q (subvec (:q cur) 1) :w nil))
            m
            (recur))
          (if (zero? ms)
            :eve.thread/timeout
            (let [p (promise)]
              (if (compare-and-set! b cur (assoc cur :w p))
                (if deadline
                  (let [left (- deadline (proc/now-ms))]
                    (if (<= left 0)
                      :eve.thread/timeout
                      (do (deref p left nil) (recur))))
                  (do (deref p) (recur)))
                (recur)))))))))

(defn stop-threads!
  "Ask each thread to end: the message :eve.thread/stop (a request its loop honours, never a kill)."
  [addrs]
  (doseq [a addrs] (send! a :eve.thread/stop)))

(defn attempt [f] (try [true (f)] (catch Throwable e [false e])))

(defn capture-frame [] (dissoc (get-thread-bindings) #'*self*))
(defn call-with-frame [frame f] (if frame (with-bindings* frame f) (f)))

(defn var-symbol
  "A var's qualified name, from the var's own metadata."
  [v]
  (let [m (meta v)]
    (symbol (str (:ns m)) (str (:name m)))))

(defn eval-form [form] (eval form))

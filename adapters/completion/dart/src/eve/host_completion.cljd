(ns eve.host-completion
  "ClojureDart's completion of its core to Clojure's, loaded first by eve.host (HOST-CONTRACT §10): what cljd.core
   lacks and eve's shared code calls. A ClojureDart namespace is compiled ahead of time and cljd.core cannot be added
   to, so a name here is found where cljd.core has none: a program's build resolves an unqualified symbol no namespace defines to the one here.

   - type: x's :type metadata, else its runtime type (Clojure's; cljd.core has no type)")

(defn type [x] (or (get (meta x) :type) (.-runtimeType ^Object x)))

 // CompareAndSet atomically sets the value to newVal only if the current value
 // is identical to oldVal, returning true on success. Identity comparison (==),
 // matching Clojure's compare-and-set!.
+// identicalValue is Clojure's identical? as atom CAS needs it: value
+// identity where Go can express it. A raw interface == panics on
+// uncomparable dynamic types (vm.ArrayVector is a slice) — Eve's
+// retire queue CASes a vector value and died on exactly that. For
+// slice-backed values, identity is same backing store and length
+// (a vector value's only identity); anything else uncomparable is
+// never identical. A PersistentVector (a vector past the 32-element
+// promotion) is uncomparable as a struct but carries an identity
+// token made for this: copies retain it, new vectors replace it —
+// without it, a CAS on a >32-element vector (Eve's retire queue at
+// 33+ entries) can never succeed and its drain loop spins forever.
+// Pointer-backed values (PersistentMap, DTypeInstance, records) are
+// the remaining hole in the first cut of this function: it answered
+// false for them, so a CAS on a map-valued atom could never succeed
+// and eve.thread-host's receive! — a CAS loop on a {:q :w} mailbox
+// map — spun forever (measured on the port tree AND the source tip:
+// plain-let-go probe, CAS on (atom {:q [] :w nil}) with its own
+// current value = false; T1 regressed with this patch, it passed
+// at #205 on stock ==). Identity for a pointer is the pointer —
+// exactly what stock == answered. (Port-tree fix, Bucket A Agent P.)
+// (EVE completion patch.)
+func identicalValue(a, b Value) bool {
+	if isComparable(a) && isComparable(b) {
+		return a == b
+	}
+	if av, ok := a.(ArrayVector); ok {
+		bv, ok := b.(ArrayVector)
+		if !ok || len(av) != len(bv) {
+			return false
+		}
+		if len(av) == 0 {
+			return true
+		}
+		return &av[0] == &bv[0]
+	}
+	if av, ok := a.(PersistentVector); ok {
+		bv, ok := b.(PersistentVector)
+		if !ok {
+			return false
+		}
+		return av.IdentityKey() != 0 && av.IdentityKey() == bv.IdentityKey()
+	}
+	if reflect.TypeOf(a) == reflect.TypeOf(b) {
+		va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+		if va.Kind() == reflect.Ptr && !va.IsNil() {
+			return va.Pointer() == vb.Pointer()
+		}
+	}
+	return false
+}

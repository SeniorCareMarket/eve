diff -ruN a/pkg/vm/value_same.go b/pkg/vm/value_same.go
--- a/pkg/vm/value_same.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/vm/value_same.go	2026-10-26 14:10:44.096231427 +0000
@@ -0,0 +1,29 @@
+package vm
+
+// valueSame: may assoc keep the map when the key already holds existing and the new value is val? Clojure's maps keep
+// it only for the identical value (PersistentArrayMap / PersistentHashMap.assoc test ==), never for a merely equal
+// one: an equal value carrying other metadata must replace the old (eve's attested records ride in their metadata).
+// Scalars without metadata compare by type and value; anything else is never the same.
+func valueSame(existing, val Value) bool {
+	switch e := existing.(type) {
+	case Int:
+		v, ok := val.(Int)
+		return ok && e == v
+	case Keyword:
+		v, ok := val.(Keyword)
+		return ok && e == v
+	case String:
+		v, ok := val.(String)
+		return ok && e == v
+	case Boolean:
+		v, ok := val.(Boolean)
+		return ok && e == v
+	case Char:
+		v, ok := val.(Char)
+		return ok && e == v
+	case *Nil:
+		_, ok := val.(*Nil)
+		return ok
+	}
+	return false
+}

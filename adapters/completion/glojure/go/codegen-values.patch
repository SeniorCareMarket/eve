+// coreVarValue names an opaque Go function value that is the root of a
+// clojure.core var (identity, str, ...) as that var's value at load time. A
+// namespace's state can hold such a value (an atom defaulting to identity, a
+// registry of core fns); the generator snapshots values, and a native Go
+// closure has no source to emit — but the var it came from does. (eve's
+// glj-eve build: without it every eve namespace whose state holds a core fn
+// panicked "unsupported function value" under *compile-files*.)
+func (g *Generator) coreVarValue(rv reflect.Value) (string, bool) {
+	core := lang.FindNamespace(lang.NewSymbol("clojure.core"))
+	if core == nil {
+		return "", false
+	}
+	var names []string
+	for seq := lang.Seq(core.Mappings()); seq != nil; seq = seq.Next() {
+		entry := seq.First()
+		sym, ok := lang.First(entry).(*lang.Symbol)
+		if !ok {
+			continue
+		}
+		second, _ := lang.Nth(entry, 1)
+		vr, ok := second.(*lang.Var)
+		if !ok || vr.Namespace() != core || !vr.IsBound() {
+			continue
+		}
+		root := reflect.ValueOf(vr.Get())
+		if root.IsValid() && root.Kind() == reflect.Func && root.Type() == rv.Type() && root.Pointer() == rv.Pointer() {
+			names = append(names, sym.Name())
+		}
+	}
+	if len(names) == 0 {
+		return "", false
+	}
+	sort.Strings(names)
+	return fmt.Sprintf("%s.Get()", g.allocVarVar("clojure.core", names[0])), true
+}

+// primitiveSliceValue emits a slice of a predeclared numeric or bool element
+// type ([]int8 — glojure's byte-array —, []byte, []int32, []float64, ...) as
+// a Go composite literal of its current elements: a namespace's constant
+// bytes (eve's codec headers, const-bytes) are such values. (eve's glj-eve
+// build: without it eve.deftype-proto.alloc's chain panicked "unsupported
+// value type []int8" under *compile-files*.)
+func primitiveSliceValue(rv reflect.Value) (string, bool) {
+	if !rv.IsValid() || rv.Kind() != reflect.Slice || rv.Type().Name() != "" {
+		return "", false
+	}
+	elem := rv.Type().Elem()
+	if elem.PkgPath() != "" || elem.Name() == "" {
+		return "", false
+	}
+	switch elem.Kind() {
+	case reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64,
+		reflect.Float32, reflect.Float64:
+	default:
+		return "", false
+	}
+	if rv.IsNil() {
+		return fmt.Sprintf("[]%s(nil)", elem.Name()), true
+	}
+	parts := make([]string, rv.Len())
+	for i := range parts {
+		x := rv.Index(i)
+		switch elem.Kind() {
+		case reflect.Float32, reflect.Float64:
+			f := x.Float()
+			if math.IsNaN(f) || math.IsInf(f, 0) {
+				return "", false
+			}
+			parts[i] = fmt.Sprint(f)
+		default:
+			parts[i] = fmt.Sprint(x.Interface())
+		}
+	}
+	return fmt.Sprintf("[]%s{%s}", elem.Name(), strings.Join(parts, ", ")), true
+}

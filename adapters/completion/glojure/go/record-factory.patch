+// recordFactories: a record type whose instances another constructor makes
+// (eve's glj-eve build: a type that stands in for a map is a Go value of
+// eve's own, made by the factory its type registers). new and ->T consult it.
+var recordFactories sync.Map
+
+// SetRecordFactory makes f the constructor of recordType's instances, for
+// (new T ...) and ->T alike.
+func SetRecordFactory(recordType *RecordType, f func(values ...any) any) {
+	recordFactories.Store(recordType, f)
+}
+
+// RecordFactoryFor is recordType's registered constructor, or nil.
+func RecordFactoryFor(recordType *RecordType) func(values ...any) any {
+	if f, ok := recordFactories.Load(recordType); ok {
+		return f.(func(values ...any) any)
+	}
+	return nil
+}

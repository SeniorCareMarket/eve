+// Nth indexes the slice from the seq's position (Nther: nth on a seq over a
+// slice in one step, not n; eve's glj-eve build).
+func (s *SliceSeq) Nth(n int) (any, bool) {
+	if n < 0 || s.i+n >= s.v.Len() {
+		return nil, false
+	}
+	return s.v.Index(s.i + n).Interface(), true
+}

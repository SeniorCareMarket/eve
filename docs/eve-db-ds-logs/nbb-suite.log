expected: nil
  actual: #error {:message "mmap_cas native addon not found — run npm install to build it", :data {:type :sci/error, :line 223, :column 7, :message "mmap_cas native addon not found — run npm install to build it", :sci.impl/callstack #object[cljs.core.Volatile {:val (#sci.impl.utils.StackFrame{:line 29, :column 13, :end-line nil, :end-column nil, :ns #object[Ls eve.domain-open-test], :file "/workspace/ds-wt-eve/test/eve/domain_open_test.cljc", :f-meta {:arglists ([base-path & {:keys [capacities lustre? durable? journal? journal-batch journal-window-ms coalesc-descriptors mem-budget segment-bytes], :or {capacities {}, lustre? false, durable? true}}]), :doc "Open or create the mmap domain at base-path (joins when its files exist).\n   Cached by path: the same path returns the same domain until\n   close-atom-domain!. Returns an MmapAtomDomain. The process whose exclusive\n   create of the .root file succeeds creates the domain; every other joins —\n   never a check of the file's existence then a create, which two processes\n   opening a fresh domain together both pass (each initialised the domain\n   over the other's writes).\n\n   Durability is the default shape of a disk domain: unless the opener\n   says otherwise, the domain is JOURNALED — commits append a record to\n   <base>.journal and the journal force is the commit point; the .root\n   file is a checkpoint (cleanup-sweep journal verdict, 2026-11-07: the\n   disk tier is journaled by design). The named opt-outs: :journal? false\n   keeps durable commits without the journal file (the pre-CAS sweep +\n   root-range force per commit carry durability alone); :durable? false\n   is the non-durable comms form — no journal, no forces, sync! is the\n   caller's explicit barrier. :mem-budget (bytes) caps the domain's total\n   region growth — refused growth names the budget, never the host's\n   out-of-memory; the MEM-BUDGET-* constants are the per-target defaults.\n   :segment-bytes (a power of two) sets the region mapping window —\n   presentation, not format: it is stored nowhere in the domain's\n   files, and processes may join the same domain with different\n   windows.", :line 1267, :column 1, :ns #object[Ls eve.atom], :name persistent-atom-domain, :file "/workspace/ds-wt-eve/src/eve/atom.cljc"}, :special false} #sci.impl.utils.StackFrame{:line 1294, :column 16, :end-line nil, :end-column nil, :ns #object[Ls eve.atom], :file "/workspace/ds-wt-eve/src/eve/atom.cljc", :f-meta {:private true, :arglists ([base-path {:keys [capacities lustre? create?], :as opts}]), :doc "Create (create? true) or join the mmap domain at base-path. Returns the\n   domain state. The process's slabs are this domain's from here on (CLJS\n   slabs are module state: one mmap domain per process). A creator writes the\n   slabs, then the root, its magic last; a joiner opens the slabs only once\n   the magic is there.", :line 678, :column 1, :ns #object[Ls eve.atom], :name open-mmap-domain!, :file "/workspace/ds-wt-eve/src/eve/atom.cljc"}, :special false} #sci.impl.utils.StackFrame{:line 686, :column 16, :end-line nil, :end-column nil, :ns #object[Ls eve.atom], :file "/workspace/ds-wt-eve/src/eve/atom.cljc", :f-meta {:arglists ([path size-bytes] [path size-bytes opts]), :doc "Open (or create) a file-backed shared memory region at path.\n   If the file is new it is truncated to size-bytes.\n   Returns a NodeMmapRegion (default) or LustreMmapRegion (when opts\n   carries :lustre? true — a provider choice at domain-open time, never\n   an ambient flag).\n\n   Example:\n     (mem/open-mmap-region \"/tmp/eve-shard-0.mem\" (* 64 1024 1024))", :line 319, :column 1, :ns #object[Ls eve.region], :name open-mmap-region, :file "/workspace/ds-wt-eve/adapters/region/js/src/eve/region.cljs"}, :special false} #sci.impl.utils.StackFrame{:line 335, :column 23, :end-line nil, :end-column nil, :ns #object[Ls eve.region], :file "/workspace/ds-wt-eve/adapters/region/js/src/eve/region.cljs", :f-meta {:private true, :arglists ([]
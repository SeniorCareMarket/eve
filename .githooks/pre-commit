#!/usr/bin/env bash
# eve pre-commit — the fleet syntax gate on staged Clojure files:
# cljfmt check (fleet .cljfmt.edn) + clj-kondo (default fail level).
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Notes: checks the working-tree content of staged paths (the usual
# partial-staging caveat); kondo reads .clj-kondo/config.edn and the
# committed cache, so keep the cache fresh (bb lint regenerates it).
# Full gate before pushing: bb lint (the per-namespace test gate is the lane record in STATUS.md).
set -euo pipefail
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(clj|cljc|cljs)$' || true)
if [ -z "$files" ]; then
  exit 0
fi
echo "pre-commit: cljfmt check (staged files)"
# shellcheck disable=SC2086
cljfmt check $files
echo "pre-commit: clj-kondo (staged files)"
# shellcheck disable=SC2086
clj-kondo --lint $files

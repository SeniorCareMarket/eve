;; lpy_costs.lpy — basilisp's per-call costs with eve loaded (doc/hosts/basilisp.md): an iteration of basilisp's
;; dotimes, an empty fn call, a variadic call, a closure made per call, (str "a" "b"), a 32-byte eve.net.bytes/hex,
;; four CPU loads on four threads against the same run serially, and a 40,000-element RRB vector's build and assoc.
(ns lpy-costs
  (:import threading time)
  (:require [eve.alpha]
            [eve.core :as e]
            [eve.net.bytes :as b]
            [eve.rrb-vector :as fv]))

(defn now-ns [] (time/perf-counter-ns))
(def n 20000)
(defmacro per-iter-us
  "µs an iteration of body over n iterations of a bare loop/recur, the bare loop's own cost subtracted"
  [body]
  `(let [t0# (now-ns)
         _# (loop [i# 0] (when (< i# n) ~body (recur (inc i#))))
         t1# (now-ns)
         _# (loop [i# 0] (when (< i# n) (recur (inc i#))))
         t2# (now-ns)]
     (/ (- (- t1# t0#) (- t2# t1#)) n 1000.0)))

(defn f0 [] nil)
(defn fv [& xs] nil)
(println "basilisp dotimes, an iteration:" (let [t0 (now-ns)] (dotimes [_ n] nil) (/ (- (now-ns) t0) n 1000.0)) "us")
(println "an empty fn call:" (per-iter-us (f0)) "us")
(println "a variadic call (two args through a rest seq):" (per-iter-us (fv 1 2)) "us")
(println "a closure made per call:" (per-iter-us (fn [] nil)) "us")
(println "(str \"a\" \"b\"):" (per-iter-us (str "a" "b")) "us")
(let [bs (vec (range 32)) m 200 t0 (now-ns)]
  (dotimes [_ m] (b/hex bs))
  (println "a 32-byte eve.net.bytes/hex:" (/ (- (now-ns) t0) m 1000000.0) "ms"))

(defn load! [] (loop [i 0 s 0] (if (< i 200000) (recur (inc i) (+ s i)) s)))
(let [t0 (now-ns) _ (dotimes [_ 4] (load!)) serial (- (now-ns) t0)
      ts (mapv (fn [_] (threading/Thread ** :target load!)) (range 4))
      t1 (now-ns)]
  (doseq [t ts] (.start t))
  (doseq [t ts] (.join t))
  (println "four CPU loads on four threads / serially:" (/ (- (now-ns) t1) (double serial))))

(let [t0 (now-ns) v (fv/vec (range 40000)) t1 (now-ns)
      m 100
      _ (reduce (fn [out k] (e/assoc out k :x)) v (range m))
      t2 (now-ns)]
  (println "a 40,000-element RRB vector: built in" (/ (- t1 t0) 1e9) "s; an assoc" (/ (- t2 t1) m 1e6) "ms"))

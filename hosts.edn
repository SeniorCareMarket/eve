 :browser ["apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/slab-io/cljs-compiler/src" "adapters/http/browser/src"
           "adapters/crypto/browser/src" "adapters/crypto/portable/src" "adapters/crypto/js-bigint/src" "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/core/cljs-compiler/src"

 :squint ["apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/http/node/src" "adapters/http-server/node/src" "adapters/crypto/node/src" "adapters/crypto/portable/src" "adapters/crypto/js-bigint/src"
          "adapters/core/squint/src" "adapters/completion/squint/src" "adapters/coll/squint/src" "adapters/slab/module/src" "adapters/typed-view/js/src"
          "adapters/region/js/src" "adapters/encoding/squint/src" "adapters/int32/js/src" "adapters/codec/squint/src"
          "adapters/process/node/src" "adapters/gc/js/src" "adapters/thread/squint/src" "adapters/types/js/src" "adapters/types/squint/src" "adapters/flat-io/portable/src"]

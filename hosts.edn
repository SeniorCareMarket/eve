;; eve's hosts: each one's adapter roots, after eve's src (adapters/README.md).
;; A host is the adapters for its capabilities; hosts with the same capability
;; share its adapter. bb.edn's tasks and the coop capstone read this file;
;; deps.edn (the JVM's :paths, ClojureScript's :node-test, the browser's :browser-test) lists the same roots.
;; flat-io (eve.flat-io, the byte seam under eve's flat layer, doc/flat/FLAT-IO.md): every row carries the inbuilt
;; adapters/flat-io/portable/src, the last root of its vector (flat lanes U2a, 2026-11-17).
;; The fast roots (flat lanes U2b, collated 2026-11-17): :jvm takes adapters/flat-io/jvm/src and :cljs / :browser take
;; adapters/flat-io/js/src, each BEFORE flat-io/portable on its row (portable's .cljc still serves the ClojureScript
;; compiler's own Clojure). Every other row keeps portable alone: bb (it would load the JVM .clj), nbb and scittle (SCI's
;; deftype takes no cljs core protocol — measured, U2b), jolt and cherry (unmeasured).
{:jvm  ["apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/http/java/src" "adapters/http-server/jdk/src" "adapters/crypto/java/src" "adapters/crypto/portable/src"
        "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/coll/jvm/src" "adapters/slab/heap/src" "adapters/region/jvm-varhandle/src"
        "adapters/encoding/java/src" "adapters/int32/jvm/src" "adapters/codec/byte-array/src" "adapters/process/java/src" "adapters/gc/java/src" "adapters/thread/jvm/src"
        "adapters/types/jvm/src" "adapters/types/js/src" "adapters/flat-io/jvm/src" "adapters/flat-io/portable/src"]
 :cljs ["apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/slab-io/cljs-compiler/src" "adapters/http/node/src" "adapters/http-server/node/src"
        "adapters/crypto/node/src" "adapters/crypto/portable/src" "adapters/crypto/js-bigint/src"
        "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/core/cljs-compiler/src"
        "adapters/coll/cljs/src" "adapters/slab/module/src" "adapters/typed-view/js/src" "adapters/region/js/src"
        "adapters/encoding/js/src" "adapters/int32/js/src" "adapters/codec/js/src" "adapters/process/node/src" "adapters/gc/js/src" "adapters/thread/node/src"
       
        ;; the compiler's own Clojure, a JVM (its macros run there and load
        ;; eve's JVM runtime): the JVM's adapters, .clj files ClojureScript
        ;; never reads (the byte-array codec's .cljc yields to the .cljs one)
        "adapters/coll/jvm/src" "adapters/slab/heap/src" "adapters/region/jvm-varhandle/src" "adapters/encoding/java/src"
        "adapters/int32/jvm/src" "adapters/codec/byte-array/src" "adapters/process/java/src" "adapters/gc/java/src" "adapters/thread/jvm/src"
        "adapters/types/jvm/src" "adapters/types/js/src" "adapters/flat-io/js/src" "adapters/flat-io/portable/src"]
 ;; ClojureScript in a browser: ClojureScript's adapters, the browser's threads (its main thread cannot block, and

(ns eve.runner.glj-main
  "EVE on glojure: the shared (.cljc) tests, run from the source tree on glj-eve (glojure with eve's Go packages and its
   completion's patches: eve/impls/glojure/build.sh). glojure's classpath is GLJ_CLASSPATH; glj has no -m, so the
   runner is called by -e (bb test:glj builds glj-eve and does both).

     GLJ_CLASSPATH=src:<hosts.edn :glj roots>:test glj-eve -e \"(require 'eve.runner.glj-main) (eve.runner.glj-main/-main \\\"test\\\")\"

   eve.host-completion loads first: a namespace refers the names the completion adds to clojure.core (deftype, reify,
   satisfies?, extends?) only when it is made after them. Exits non-zero on a failure."
  (:require [eve.host-completion]
            [clojure.test :as t]))

;; one line per test as it ends, with its time: a suite that stalls names the test it stalled in
(def ^:private test-start (atom 0))
(defmethod t/report :begin-test-var [_] (reset! test-start (.UnixMilli (time.Now))))
(defmethod t/report :end-test-var [m]
  (println "done" (:var m) (str (- (.UnixMilli (time.Now)) @test-start) "ms")))

(def shared-tests
  "The test namespaces glojure runs as written, by default. Not eve.rrb-vector-test: core.rrb-vector's suite takes ~24
   min on glj-eve (2026-10-20: test-reduce-subvec-catvec alone 230 s, 2,371 catvecs), as on basilisp it runs when
   named, whole or by test (eve.rrb-vector-test/test-seq). eve.array's typed arrays (coalesc-align, array-hosts,
   dataset, tensor) run here too, over the Go encoding adapter's typed arrays (eve/adapters/encoding/go):
   43 tests / 226 assertions green when named, 2026-10-23."
  '[eve.hamt-util-test eve.eve-bytes-fixture-test eve.deftype.type-id-test
    eve.deftype.rb-tree-test eve.numeric-tags-test eve.collection-hash-test eve.reference-tag-test eve.big-value-test
    eve.sorted-coll-test eve.keyring-test eve.value-buffer-test eve.vec-retire-test eve.reclaim-test eve.tally-test eve.read-region-test eve.domain-open-test
    eve.deftype.int-map-test eve.thread-host-test eve.thread-test eve.thread-meta-test eve.thread-domain-test
    eve.thread-net-test eve.thread-fold-test eve.thread-fold-group-test
    ;; the crypto feature's fast-path rows (Go's crypto through impls/glojure/host/crypto.go)
    eve.net.crypto-fast-path-test])

(defn -main [& [cmd & args]]
  (case cmd
    "test" (let [syms (if (seq args) (map symbol args) shared-tests)
                 ;; ns/name: that one test (with its namespace's fixtures)
                 tests (filter namespace syms)
                 nses (remove namespace syms)
                 _ (apply require (distinct (concat nses (map (comp symbol namespace) tests))))
                 r (merge-with + (when (seq nses) (apply t/run-tests nses))
                               (when (seq tests)
                                 (binding [t/*report-counters* (ref t/*initial-report-counters*)]
                                   (t/test-vars (map resolve tests))
                                   @t/*report-counters*)))]
             (println :summary (select-keys r [:test :pass :fail :error]))
             (os.Exit (if (zero? (+ (:fail r 0) (:error r 0))) 0 1)))
    "perf" (do (require 'eve.perf-suite)
               ((resolve 'eve.perf-suite/run!) {:budget-ms (some-> (first args) read-string)})
               (os.Exit 0))
    (do (println "usage: -main test [ns ...]")
        (os.Exit 2))))

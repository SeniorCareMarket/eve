;; the JVM: eve's shared code and the JVM's adapters (hosts.edn :jvm)
{:paths ["src" "apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/http/java/src" "adapters/http-server/jdk/src" "adapters/crypto/java/src" "adapters/crypto/portable/src" "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/coll/jvm/src" "adapters/slab/heap/src" "adapters/region/jvm-varhandle/src"
         "adapters/encoding/java/src" "adapters/int32/jvm/src" "adapters/codec/byte-array/src"
         "adapters/process/java/src" "adapters/gc/java/src" "adapters/thread/jvm/src" "adapters/types/jvm/src" "adapters/types/js/src"
         ;; eve.flat-io: the JVM fast root, then the inbuilt root (hosts.edn's :jvm row)
         "adapters/flat-io/jvm/src" "adapters/flat-io/portable/src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:node-test
  ;; ClojureScript: eve's shared code and ClojureScript's adapters (hosts.edn :cljs)
  {:replace-paths ["src" "apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/slab-io/cljs-compiler/src" "adapters/http/node/src"
                   "adapters/http-server/node/src" "adapters/crypto/node/src" "adapters/crypto/js-bigint/src"
                   ;; the portable crypto adapter: its eve.crypto is a .cljc, the only JVM-loadable form — the CLJS
                   ;; macro pass loads shared .cljc sources (eve.digest et al. require eve.crypto) as Clojure, and the
                   ;; node adapter's .cljs is invisible to it. Runtime resolution still prefers the node .cljs.
                   "adapters/crypto/portable/src"
                   "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/core/cljs-compiler/src"
                   "adapters/coll/cljs/src" "adapters/slab/module/src" "adapters/typed-view/js/src"
                   "adapters/region/js/src" "adapters/encoding/js/src" "adapters/int32/js/src" "adapters/codec/js/src"
                   "adapters/process/node/src" "adapters/gc/js/src" "adapters/thread/node/src"
                   ;; the compiler's own Clojure (a JVM)
                   "adapters/coll/jvm/src" "adapters/slab/heap/src"
                   "adapters/region/jvm-varhandle/src" "adapters/encoding/java/src" "adapters/int32/jvm/src"
                   "adapters/codec/byte-array/src" "adapters/process/java/src" "adapters/gc/java/src" "adapters/thread/jvm/src"
                   "adapters/types/jvm/src" "adapters/types/js/src"
                   ;; eve.flat-io, the inbuilt root: its .cljc serves the compile and the compiler's own Clojure
                   ;; (hosts.edn's :cljs row: the ClojureScript fast root first)
                   "adapters/flat-io/js/src" "adapters/flat-io/portable/src"]
   :extra-paths ["test" "apps/network-atoms/test"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.6"}
                org.clojure/test.check {:mvn/version "1.1.1"}}}
  ;; ClojureScript in a browser (hosts.edn :browser): the browser's threads in place of Node's; the
  ;; thread feature's conformance page (bb test:browser runs shadow through this alias)
  :browser-test
  {:replace-paths ["src" "apps/network-atoms/src" "adapters/slab-io/protocol/src" "adapters/slab-io/cljs-compiler/src" "adapters/http/browser/src"
                   "adapters/crypto/browser/src" "adapters/crypto/js-bigint/src"
                   ;; the portable crypto adapter, as in :node-test: JVM-loadable eve.crypto (.cljc) for the macro pass
                   "adapters/crypto/portable/src" "adapters/core/clojure/src" "adapters/completion/clojure/src" "adapters/core/cljs-compiler/src"
                   "adapters/coll/cljs/src" "adapters/slab/module/src" "adapters/typed-view/js/src" "adapters/region/js/src"
                   "adapters/encoding/js/src" "adapters/int32/js/src" "adapters/codec/js/src" "adapters/process/node/src" "adapters/gc/js/src"
                   "adapters/thread/browser/src" "adapters/opfs/browser/src" "adapters/dom/browser/src"
                   "adapters/coll/jvm/src" "adapters/slab/heap/src" "adapters/region/jvm-varhandle/src" "adapters/encoding/java/src"
                   "adapters/int32/jvm/src" "adapters/codec/byte-array/src" "adapters/process/java/src" "adapters/gc/java/src"
                   "adapters/thread/jvm/src" "adapters/types/jvm/src" "adapters/types/js/src"
                   ;; eve.flat-io: the ClojureScript fast root, then the inbuilt root (as :node-test)
                   "adapters/flat-io/js/src" "adapters/flat-io/portable/src"]
   :extra-paths ["test" "apps/network-atoms/test"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.6"}}}
  ;; cohost-media, the capstone (capstone/cohost-media): its ClojureScript sources — the page's (the browser
  ;; runtime and its view, rendered with reagami as the cljs-thread reagami-counter example is), added to
  ;; :browser-test; it loads the one shared cohost-media.tasks. (The Node member has no build: it is the
  ;; shared sources loaded into a cohost :node realm at start, on the boot program's classpath.)
  :cohost-media-page
  {:extra-paths ["capstone/cohost-media/src" "capstone/cohost-media/page/src"]
   :extra-deps {io.github.borkdude/reagami {:git/tag "v0.0.36" :git/sha "562cf3d"}}}
  ;; eve.dom's acceptance demo (bb test:browser:dom-demo): reagami and canvas-confetti in the program's main worker,
  ;; added to :browser-test
  :dom-demo
  {:extra-paths ["adapters/dom/browser/demo/src"]
   :extra-deps {io.github.borkdude/reagami {:git/tag "v0.0.36" :git/sha "562cf3d"}}}
  ;; eve's local network, the page's sources (bb net:local), added to :browser-test
  :net-local-page
  {:extra-paths ["net-local/page/src"]}
  :jvm-test
  {:extra-paths ["test" "apps/network-atoms/test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}
  ;; eve.flat-io's conformance test (adapters/flat-io/test) on the JVM, over the root the classpath carries:
  ;; clojure -M:flat-io-test
  :flat-io-test
  {:extra-paths ["test" "adapters/flat-io/test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED" "--enable-native-access=ALL-UNNAMED"]
   :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "adapters/flat-io/test" "-n" "eve.flat-io-conformance-test"]}
  ;; the same test on Node, added to :node-test (its runner build is shadow-cljs.edn's :flat-io-test):
  ;; clojure -M:node-test:flat-io-node -m shadow.cljs.devtools.cli compile flat-io-test && node target/flat-io-test/main.js
  :flat-io-node
  {:extra-paths ["adapters/flat-io/test"]}
  ;; the crypto invariant smoke set on the JVM (eve.runner.bb-main's smoke-tests, the same namespaces):
  ;; clojure -M:jvm-smoke
  :jvm-smoke
  {:extra-paths ["test" "apps/aegis/test" "apps/network-atoms/test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test"
               "-n" "eve.aegis.clsag-test"
               "-n" "eve.aegis.rsabssa-test" "-n" "eve.aegis.h2c-test"
               "-n" "eve.aegis.hpke-test" "-n" "eve.aegis.merkle-test"
               "-n" "eve.aegis.regions-test" "-n" "eve.aegis.regions-claims-test"
               "-n" "eve.keyring-test"
               "-n" "eve.net.crypto-test" "-n" "eve.net.crypto-fast-path-test"
               "-n" "eve.net.ed25519-test"]}
  ;; eve's performance suite on the JVM (test/eve/perf_suite.cljc; every host's runner has a perf command too):
  ;; clojure -M:perf
  :perf
  {:extra-paths ["test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED" "--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-e" "(require 'eve.perf-suite) (eve.perf-suite/run! {}) (System/exit 0)"]}
  :jvm-e2e-test
  {:extra-paths ["test" "test-e2e"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-e2e"]}
  :native-build-atom
  {:extra-paths ["bench"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx1g"]
   :main-opts ["-m" "eve.build-atom"]}
  :native-x-stress-atom
  {:extra-paths ["bench"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx1g"]
   :main-opts ["-m" "eve.stress-atom"]}
  :native-profiled-stress
  {:extra-paths ["bench"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx1g"]
   :main-opts ["-m" "eve.profiled-stress"]}
  :native-data-bench
  {:extra-paths ["bench"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx1g"]
   :main-opts ["-m" "eve.data-bench"]}
  :columnar-bench
  {:extra-paths ["test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx4g"]
   :main-opts ["-m" "eve.columnar-bench"]}
  :perf-audit
  {:extra-paths ["test"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx4g"]
   :main-opts ["-m" "eve.perf-audit"]}
  :contention-bench
  {:extra-paths ["bench"]
   :jvm-opts ["--add-opens" "java.base/java.lang=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "-Xmx1g"]
   :main-opts ["-m" "eve.contention-bench"]}
  :mcp {:extra-deps {io.github.bhauman/clojure-mcp {:git/tag "v0.2.6" :git/sha "35a660b"}}
        :exec-fn clojure-mcp.main/start
        :exec-args {:config-profile :cli-assist}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       cider/cider-nrepl {:mvn/version "0.50.3"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
